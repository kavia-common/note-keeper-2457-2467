# Django/PostgreSQL database environment variables

DB_NAME=notes
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Optionally, you can use a full database URL:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/notes

# (Container setups may prefer legacy POSTGRES_* as fallback for compatibility)
POSTGRES_DB=notes
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_URL=localhost
POSTGRES_PORT=5432

# Django secret key & debug
# SECRET_KEY=your-secret
# DEBUG=True
